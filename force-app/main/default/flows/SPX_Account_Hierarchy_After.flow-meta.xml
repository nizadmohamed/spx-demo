    <decisions>
        <name>Has_Parent</name>
        <label>Has Parent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector><targetReference>Old_Parent_Check</targetReference></defaultConnector>
        <defaultConnectorLabel>No parent</defaultConnectorLabel>
        <rules>
            <name>Parent_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ParentId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Get_New_Parent</targetReference></connector>
            <label>Has parent</label>
        </rules>
    </decisions>
    <decisions>
        <name>Old_Parent_Check</name>
        <label>Old Parent Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector><targetReference>Cascade_Check</targetReference></defaultConnector>
        <defaultConnectorLabel>Not moved</defaultConnectorLabel>
        <rules>
            <name>Moved_From_Parent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fMovedFromParent</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Get_Old_Parent</targetReference></connector>
            <label>Moved from a parent</label>
        </rules>
    </decisions>
    <decisions>
        <name>Cascade_Check</name>
        <label>Cascade Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No cascade</defaultConnectorLabel>
        <rules>
            <name>Hierarchy_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fCascade</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Update_Children_Global_Ultimate</targetReference></connector>
            <label>Hierarchy changed</label>
        </rules>
    </decisions>
    <description>Account hierarchy, after save. Keeps Is Global Parent correct on the new and old parent, pushes Global Ultimate to child accounts, and repoints Global Parent on the account Brand Relationships, Project Relationships, ERP references and contacts. Handles any depth by cascading level by level.</description>
    <formulas>
        <name>fCascade</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISNEW()), OR(ISCHANGED({!$Record.Global_Ultimate__c}), ISCHANGED({!$Record.ParentId})))</expression>
    </formulas>
    <formulas>
        <name>fMovedFromParent</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISNEW()), ISCHANGED({!$Record.ParentId}), NOT(ISBLANK({!$Record__Prior.ParentId})))</expression>
    </formulas>
    <formulas>
        <name>fMyGU</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Global_Ultimate__c}), {!$Record.Id}, {!$Record.Global_Ultimate__c})</expression>
    </formulas>
    <formulas>
        <name>fNewParentIsGP</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!Get_New_Parent.ParentId})</expression>
    </formulas>
    <formulas>
        <name>fOldParentIsGP</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISBLANK({!Get_Old_Parent.ParentId}), {!varOldCount} &gt; 0)</expression>
    </formulas>
    <interviewLabel>SPX Account Hierarchy After {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SPX Account Hierarchy - After Save</label>
    <processMetadataValues>
