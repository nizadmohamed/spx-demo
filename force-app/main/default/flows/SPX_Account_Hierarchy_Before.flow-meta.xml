    <description>Account hierarchy, before save. Sets Global Ultimate from the parent (blank for a top-level account) and Is Global Parent (no parent and at least one child).</description>
    <formulas>
        <name>fGU</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Parent.Global_Ultimate__c}), {!Get_Parent.Id}, {!Get_Parent.Global_Ultimate__c})</expression>
    </formulas>
    <formulas>
        <name>fIsGP</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISBLANK({!$Record.ParentId}), {!varChildCount} &gt; 0)</expression>
    </formulas>
    <formulas>
        <name>fIsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>SPX Account Hierarchy Before {!$Flow.CurrentDateTime}</interviewLabel>
