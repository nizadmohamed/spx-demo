    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Get_Parent</targetReference></connector>
        <filterFormula>AND(NOT({!$Permission.SPX_Bypass_Automation}), OR(ISNEW(), ISCHANGED({!$Record.ParentId})))</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
