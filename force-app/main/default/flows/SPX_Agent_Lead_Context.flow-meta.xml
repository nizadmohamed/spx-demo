            <value>
                <elementReference>fPrompt</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Has_Engineer</name>
        <label>Has Engineer</label>
        <locationX>380</locationX>
        <locationY>758</locationY>
        <defaultConnector>
            <targetReference>Build_Prompt</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No engineer</defaultConnectorLabel>
        <rules>
            <name>Engineer_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Lead.Engineer_of_Record__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Other_Project</targetReference>
            </connector>
            <label>Engineer set</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Project</name>
        <label>Has Project</label>
        <locationX>380</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Has_Engineer</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No project</defaultConnectorLabel>
        <rules>
            <name>Project_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Lead.Project__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Sibling_Leads</targetReference>
            </connector>
            <label>Project set</label>
        </rules>
    </decisions>
    <decisions>
        <name>Other_Project_Found</name>
        <label>Other Project Found</label>
        <locationX>578</locationX>
        <locationY>950</locationY>
        <defaultConnector>
            <targetReference>Build_Prompt</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Other_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Other_Project</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_BOD_Opps</targetReference>
            </connector>
            <label>Other project exists</label>
        </rules>
    </decisions>
    <description>Read only context for the Summarize Lead prompt template. Returns the other brand leads on the same project and, when the engineer of record is also on another SPX project, that project and which brands hold the basis of design there. Never changes a record.</description>
    <environments>Default</environments>
    <formulas>
        <name>fBodBrandText</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varBodBrands}), &quot;&quot;, &quot;, &quot;) &amp; TEXT({!Loop_BOD.Brand__c})</expression>
    </formulas>
    <formulas>
        <name>fOtherProjectId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Lead.Project__c}), &quot;000000000000000&quot;, {!Lead.Project__c})</expression>
    </formulas>
    <formulas>
        <name>fPrompt</name>
        <dataType>String</dataType>
        <expression>&quot;Other brand leads on this same project: &quot; &amp; IF(ISBLANK({!varSiblings}), &quot;none.&quot;, {!varSiblings} &amp; &quot;.&quot;) &amp; IF(ISBLANK({!Get_Other_Project.Name}), &quot; No other SPX project shares this engineer of record.&quot;, &quot; The same engineer of record is also on another SPX project, &quot; &amp; {!Get_Other_Project.Name} &amp; &quot; (&quot; &amp; TEXT({!Get_Other_Project.Project_Phase__c}) &amp; &quot;, project reference &quot; &amp; IF(ISBLANK({!Get_Other_Project.Project_Reference__c}), &quot;n/a&quot;, {!Get_Other_Project.Project_Reference__c}) &amp; &quot;). Basis of design secured there by: &quot; &amp; IF(ISBLANK({!varBodBrands}), &quot;no brand yet&quot;, {!varBodBrands}) &amp; &quot;.&quot;)</expression>
    </formulas>
    <formulas>
        <name>fSiblingText</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varSiblings}), &quot;&quot;, &quot;; &quot;) &amp; TEXT({!Loop_Siblings.Brand__c}) &amp; &quot; (&quot; &amp; TEXT({!Loop_Siblings.Status}) &amp; &quot;)&quot;</expression>
    </formulas>
    <interviewLabel>SPX Agent Lead Context {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SPX Agent Lead Context</label>
    <loops>
        <name>Loop_BOD</name>
        <label>Loop BOD</label>
        <locationX>380</locationX>
        <locationY>1142</locationY>
        <collectionReference>Get_BOD_Opps</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_BOD_Brand</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Build_Prompt</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Siblings</name>
        <label>Loop Siblings</label>
        <locationX>248</locationX>
        <locationY>350</locationY>
        <collectionReference>Get_Sibling_Leads</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Sibling</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Has_Engineer</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_BOD_Opps</name>
        <label>Get BOD Opps</label>
        <locationX>380</locationX>
        <locationY>1034</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_BOD</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Project__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Other_Project.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>BOD_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Secured</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Other_Project</name>
        <label>Get Other Project</label>
        <locationX>380</locationX>
        <locationY>866</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Other_Project_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Engineer_of_Record__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Lead.Engineer_of_Record__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>fOtherProjectId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Project__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Sibling_Leads</name>
        <label>Get Sibling Leads</label>
        <locationX>248</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Siblings</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Project__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Lead.Project__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>Lead.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsConverted</field>
