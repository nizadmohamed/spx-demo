    <description>Sends one in-app notification to the brand sales leader group (for example TAMCO) about a project, using the New strategic project in your territory notification type. The agent must ask the user to confirm before running this. Does not create or change any record.</description>
    <environments>Default</environments>
    <formulas>
        <name>fNotifBody</name>
        <dataType>String</dataType>
        <expression>&quot;Segment operations flagged project &quot; &amp; {!projectName} &amp; &quot; for &quot; &amp; {!brandName} &amp; &quot;. Please take a look.&quot;</expression>
    </formulas>
    <formulas>
        <name>fNotifTitle</name>
        <dataType>String</dataType>
        <expression>&quot;Project to review: &quot; &amp; {!projectName}</expression>
    </formulas>
    <formulas>
        <name>fRoleName</name>
        <dataType>String</dataType>
        <expression>CASE({!brandName}, &quot;Ingénia&quot;, &quot;Ingenia_Brand_Sales_Leader&quot;, &quot;Ingenia&quot;, &quot;Ingenia_Brand_Sales_Leader&quot;, &quot;Cooling&quot;, &quot;Cooling_Brand_Sales_Leader&quot;, &quot;Patterson-Kelley&quot;, &quot;PK_Brand_Sales_Leader&quot;, &quot;TAMCO&quot;, &quot;TAMCO_Brand_Sales_Leader&quot;, &quot;Marley&quot;, &quot;Marley_Brand_Sales_Leader&quot;, &quot;Strobic&quot;, &quot;Strobic_Brand_Sales_Leader&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fSentText</name>
        <dataType>String</dataType>
        <expression>&quot;Notified the &quot; &amp; {!brandName} &amp; &quot; brand sales leader about &quot; &amp; {!projectName} &amp; &quot;.&quot;</expression>
    </formulas>
    <interviewLabel>SPX Agent Notify Brand Leader {!$Flow.CurrentDateTime}</interviewLabel>
