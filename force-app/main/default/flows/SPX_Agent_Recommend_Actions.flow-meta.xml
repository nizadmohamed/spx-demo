        <name>fResult</name>
        <dataType>String</dataType>
        <expression>{!Run_NBA.message} &amp; IF(ISBLANK({!Run_NBA.createdActions}), &quot;&quot;, &quot; &quot; &amp; {!Run_NBA.createdActions})</expression>
    </formulas>
