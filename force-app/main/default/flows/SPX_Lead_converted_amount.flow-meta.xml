<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>When an SPX lead is converted, sets the new opportunity to stage 1.0 (the Golden Template process has no default stage) and Amount to the lead Est. Brand Potential. Handover Pack section 2 item 3: the standard Amount field cannot be mapped, so a flow does it.</description>
    <decisions>
        <name>Has_Potential</name>
        <label>Has Potential</label>
        <locationX>376</locationX>
        <locationY>110</locationY>
        <defaultConnector>
            <targetReference>Update_Opportunity_Stage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Potential</defaultConnectorLabel>
        <rules>
            <name>Potential_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Est_Brand_Potential__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
        <connector>
            <targetReference>Update_Opportunity_Stage_And_Amount</targetReference>
        </connector>
            <label>Potential Present</label>
        </rules>
    </decisions>
    <interviewLabel>SPX Lead converted amount {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SPX Lead converted amount</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Opportunity_Stage_And_Amount</name>
        <label>Update Opportunity Stage And Amount</label>
        <locationX>576</locationX>
        <locationY>170</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.ConvertedOpportunityId</elementReference></value>
        </filters>
        <inputAssignments>
            <field>StageName</field>
            <value><stringValue>1.0 Prospect and Market ID</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Amount</field>
            <value><elementReference>$Record.Est_Brand_Potential__c</elementReference></value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Opportunity_Stage</name>
        <label>Update Opportunity Stage</label>
        <locationX>176</locationX>
        <locationY>230</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.ConvertedOpportunityId</elementReference></value>
        </filters>
        <inputAssignments>
            <field>StageName</field>
            <value><stringValue>1.0 Prospect and Market ID</stringValue></value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Potential</targetReference>
        </connector>
        <filterFormula>AND(NOT({!$Permission.SPX_Bypass_Automation}), {!$Record.IsConverted}, ISCHANGED({!$Record.IsConverted}), NOT(ISBLANK({!$Record.ConvertedOpportunityId})), NOT(ISBLANK(TEXT({!$Record.Brand__c}))))</filterFormula>
        <object>Lead</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
