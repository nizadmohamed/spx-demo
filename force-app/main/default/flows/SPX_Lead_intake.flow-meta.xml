    <formulas>
        <name>fProjectName</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Project_Name__c})), {!$Record.Project_Name__c}, {!$Record.LastName})</expression>
    </formulas>
    <formulas>
        <name>fVerticalText</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Vertical__c})</expression>
    </formulas>
    <formulas>
        <name>fIsAHU</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!Get_Potential_Factor.Id})), {!Get_Potential_Factor.Calculation_Type__c} = "AHU_AIRFLOW", NOT(ISBLANK({!$Record.Est_Construction_Value__c})), {!Get_Potential_Factor.Factor_1__c} &gt; 0)</expression>
    </formulas>
    <formulas>
        <name>fSqFt</name>
        <dataType>Number</dataType>
        <expression>IF({!fIsAHU}, {!$Record.Est_Construction_Value__c} / {!Get_Potential_Factor.Factor_1__c}, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fCfm</name>
        <dataType>Number</dataType>
        <expression>IF({!fIsAHU}, {!fSqFt} * {!Get_Potential_Factor.Factor_2__c}, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fPotential</name>
        <dataType>Number</dataType>
        <expression>IF({!fIsAHU}, ROUND({!fCfm} * {!Get_Potential_Factor.Factor_3__c}, -5), 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fBasisText</name>
        <dataType>String</dataType>
        <expression>"$" &amp; TEXT(ROUND({!$Record.Est_Construction_Value__c} / 1000000, 0)) &amp; "M ÷ ~$" &amp; TEXT({!Get_Potential_Factor.Factor_1__c}) &amp; " per sq ft ≈ " &amp; TEXT(ROUND({!fSqFt}, -3) / 1000) &amp; ",000 sq ft × ~" &amp; TEXT({!Get_Potential_Factor.Factor_2__c}) &amp; " cfm per sq ft ≈ " &amp; TEXT(ROUND({!fCfm}, -3) / 1000) &amp; ",000 cfm × ~$" &amp; TEXT({!Get_Potential_Factor.Factor_3__c}) &amp; " per cfm" &amp; IF(ISBLANK({!Get_Potential_Factor.Basis_Note__c}), "", " " &amp; {!Get_Potential_Factor.Basis_Note__c})</expression>
    </formulas>
    <formulas>
        <name>fEligible</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!$Record.Est_Construction_Value__c})), NOT(ISBLANK(TEXT({!$Record.Vertical__c}))), CONTAINS({!Get_Brand_Config.Target_Verticals__c}, TEXT({!$Record.Vertical__c})), {!$Record.Est_Construction_Value__c} &gt;= {!Get_Brand_Config.Routing_Threshold__c}, CASE(TEXT({!$Record.Project_Phase__c}), "Planning", 1, "Schematic Design", 2, "Design Development", 3, "Construction Documents", 4, "Bid", 5, "Awarded", 6, 0) &gt;= CASE({!Get_Brand_Config.Earliest_Routing_Phase__c}, "Planning", 1, "Schematic Design", 2, "Design Development", 3, "Construction Documents", 4, "Bid", 5, "Awarded", 6, 99))</expression>
    </formulas>
    <formulas>
        <name>fStrategic</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!$Record.Est_Construction_Value__c})), NOT(ISBLANK({!Get_Brand_Config.Strategic_Threshold__c})), {!$Record.Est_Construction_Value__c} &gt; {!Get_Brand_Config.Strategic_Threshold__c})</expression>
    </formulas>
    <formulas>
        <name>fMatchResult</name>
        <dataType>String</dataType>
        <expression>IF({!varWasMatched}, "Matched", "New project created")</expression>
    </formulas>
    <formulas>
        <name>fThreshText</name>
        <dataType>String</dataType>
        <expression>"Met: $" &amp; TEXT(ROUND({!$Record.Est_Construction_Value__c} / 1000000, 1)) &amp; "M is over $" &amp; TEXT(ROUND({!Get_Brand_Config.Routing_Threshold__c} / 1000000, 0)) &amp; "M"</expression>
    </formulas>
    <formulas>
        <name>fRoleName</name>
        <dataType>String</dataType>
        <expression>CASE({!Get_Brand_Config.Brand_Value__c}, "Ingénia", "Ingenia_Brand_Sales_Leader", "Cooling", "Cooling_Brand_Sales_Leader", "Patterson-Kelley", "PK_Brand_Sales_Leader", "TAMCO", "TAMCO_Brand_Sales_Leader", "Chicago Fan", "CF_Brand_Sales_Leader", "Marley", "Marley_Brand_Sales_Leader", "Strobic", "Strobic_Brand_Sales_Leader", "")</expression>
    </formulas>
    <formulas>
        <name>fNotifBody</name>
        <dataType>String</dataType>
        <expression>"Project " &amp; {!fProjectName} &amp; " (" &amp; TEXT({!$Record.Vertical__c}) &amp; ", " &amp; TEXT({!$Record.Project_Phase__c}) &amp; ") is a strategic project from the ConstructConnect feed. A lead was routed for your brand."</expression>
    </formulas>
