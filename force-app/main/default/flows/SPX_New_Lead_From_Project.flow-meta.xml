    <description>Manual lead from a Project: captures brand details and contact, creates the lead with Project Intelligence and address copied from the Project. The SPX Lead intake flow then applies the standard routing.</description>
    <dynamicChoiceSets>
        <name>ccBrand</name>
        <dataType>Picklist</dataType>
        <picklistField>Brand__c</picklistField>
        <picklistObject>Lead</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>ccBOD</name>
        <dataType>Picklist</dataType>
        <picklistField>BOD_Status__c</picklistField>
        <picklistObject>Lead</picklistObject>
    </dynamicChoiceSets>
    <formulas>
        <name>f_Company</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!sc_Company}), TRIM(IF(ISBLANK({!sc_FirstName}), &quot;&quot;, {!sc_FirstName} &amp; &quot; &quot;) &amp; {!sc_LastName}), {!sc_Company})</expression>
    </formulas>
    <interviewLabel>SPX New Lead from Project {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SPX New Lead from Project</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Lead</name>
        <label>Create Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Screen_Done</targetReference></connector>
        <faultConnector><targetReference>Screen_Error</targetReference></faultConnector>
        <inputReference>vLead</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Project</name>
        <label>Get Project</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Screen_Brand</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Project__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
