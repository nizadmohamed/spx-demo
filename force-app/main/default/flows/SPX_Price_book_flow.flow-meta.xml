<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Before-save: sets the Opportunity price book from the brand and opportunity currency. Name convention: [Brand] [Year] List ([Currency]). Leaves the price book unchanged when none matches. Handover Pack section 6.</description>
    <assignments>
        <name>Set_Price_Book</name>
        <label>Set Price Book</label>
        <locationX>376</locationX>
        <locationY>110</locationY>
        <assignmentItems>
            <assignToReference>$Record.Pricebook2Id</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Get_Price_Book.Id</elementReference></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_BU</name>
        <label>Set BU</label>
        <locationX>576</locationX>
        <locationY>170</locationY>
        <assignmentItems>
            <assignToReference>$Record.BU__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Get_Brand_Configuration.BU__c</elementReference></value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Price_Book</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Brand_Configured</name>
        <label>Brand Configured</label>
        <locationX>176</locationX>
        <locationY>230</locationY>
        <defaultConnectorLabel>No Brand Configuration</defaultConnectorLabel>
        <rules>
            <name>Config_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Brand_Configuration</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
        <connector>
            <targetReference>Set_BU</targetReference>
        </connector>
            <label>Config Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Price_Book_Found</name>
        <label>Price Book Found</label>
        <locationX>376</locationX>
        <locationY>290</locationY>
        <defaultConnectorLabel>No Matching Price Book</defaultConnectorLabel>
        <rules>
            <name>Match_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Price_Book</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
        <connector>
            <targetReference>Set_Price_Book</targetReference>
        </connector>
            <label>Match Found</label>
        </rules>
    </decisions>
    <formulas>
        <name>fCurrencyToken</name>
        <dataType>String</dataType>
        <expression>"(" &amp; TEXT({!$Record.CurrencyIsoCode}) &amp; ")"</expression>
    </formulas>
    <interviewLabel>SPX Price book flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SPX Price book flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Brand_Configuration</name>
        <label>Get Brand Configuration</label>
        <locationX>176</locationX>
        <locationY>410</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Brand_Configured</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Brand_Value__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Brand__c</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Brand_Configuration__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Price_Book</name>
        <label>Get Price Book</label>
        <locationX>576</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Price_Book_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value><elementReference>Get_Brand_Configuration.Brand_Value__c</elementReference></value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value><elementReference>fCurrencyToken</elementReference></value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value><booleanValue>true</booleanValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Pricebook2</object>
        <sortField>Name</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Brand_Configuration</targetReference>
        </connector>
        <filterFormula>AND(NOT({!$Permission.SPX_Bypass_Automation}), NOT(ISBLANK(TEXT({!$Record.Brand__c}))), OR(ISNEW(), ISCHANGED({!$Record.Brand__c}), ISCHANGED({!$Record.CurrencyIsoCode})))</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
