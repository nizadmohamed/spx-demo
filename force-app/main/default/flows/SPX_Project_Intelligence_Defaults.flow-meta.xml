    </assignments>
    <assignments>
        <name>Clear_Type</name>
        <label>Clear Project Intelligence Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Project_Intelligence_Type__c</assignToReference>
