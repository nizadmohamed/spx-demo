<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Recalculates Project totals, brands engaged and BOD secured. Handover Pack section 4, Flow 1.</description>
    <assignments>
        <name>Add_Amount</name>
        <label>Add Amount</label>
        <locationX>376</locationX>
        <locationY>110</locationY>
        <assignmentItems>
            <assignToReference>varTotal</assignToReference>
            <operator>Add</operator>
            <value><elementReference>fAmount</elementReference></value>
        </assignmentItems>
        <connector>
            <targetReference>Brand_Already_Listed</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Brand</name>
        <label>Add Brand</label>
        <locationX>576</locationX>
        <locationY>170</locationY>
        <assignmentItems>
            <assignToReference>varBrands</assignToReference>
            <operator>Add</operator>
            <value><elementReference>fBrand</elementReference></value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Secured</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Secured_Brand</name>
        <label>Add Secured Brand</label>
        <locationX>176</locationX>
        <locationY>230</locationY>
        <assignmentItems>
            <assignToReference>varSecuredBrands</assignToReference>
            <operator>Add</operator>
            <value><elementReference>fBrand</elementReference></value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Opps</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Counts</name>
        <label>Set Counts</label>
        <locationX>376</locationX>
        <locationY>290</locationY>
        <assignmentItems>
            <assignToReference>varBrandsCount</assignToReference>
            <operator>AssignCount</operator>
            <value><elementReference>varBrands</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varBODCount</assignToReference>
            <operator>AssignCount</operator>
            <value><elementReference>varSecuredBrands</elementReference></value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Project</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Brand_Already_Listed</name>
        <label>Brand Already Listed</label>
        <locationX>576</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Add_Brand</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Listed</defaultConnectorLabel>
        <rules>
            <name>Listed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varBrands</leftValueReference>
                <operator>Contains</operator>
                <rightValue><elementReference>fBrand</elementReference></rightValue>
            </conditions>
        <connector>
            <targetReference>Is_Secured</targetReference>
        </connector>
            <label>Listed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Secured</name>
        <label>Is Secured</label>
        <locationX>176</locationX>
        <locationY>410</locationY>
        <defaultConnector>
            <targetReference>Loop_Opps</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Secured</defaultConnectorLabel>
        <rules>
            <name>Secured</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fBOD</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Secured</stringValue></rightValue>
            </conditions>
        <connector>
            <targetReference>Secured_Brand_Listed</targetReference>
        </connector>
            <label>Secured</label>
        </rules>
    </decisions>
    <decisions>
        <name>Secured_Brand_Listed</name>
        <label>Secured Brand Listed</label>
        <locationX>376</locationX>
        <locationY>470</locationY>
        <defaultConnector>
            <targetReference>Add_Secured_Brand</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Listed</defaultConnectorLabel>
        <rules>
            <name>Secured_Listed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varSecuredBrands</leftValueReference>
                <operator>Contains</operator>
                <rightValue><elementReference>fBrand</elementReference></rightValue>
            </conditions>
        <connector>
            <targetReference>Loop_Opps</targetReference>
        </connector>
            <label>Secured Listed</label>
        </rules>
    </decisions>
    <formulas>
        <name>fAmount</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!Loop_Opps.Amount}), 0, {!Loop_Opps.Amount})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fBODText</name>
        <dataType>String</dataType>
        <expression>TEXT({!varBODCount}) &amp; " of " &amp; TEXT({!varBrandsCount})</expression>
    </formulas>
    <formulas>
        <name>fBrand</name>
        <dataType>String</dataType>
        <expression>TEXT({!Loop_Opps.Brand__c})</expression>
    </formulas>
    <formulas>
        <name>fBOD</name>
        <dataType>String</dataType>
        <expression>TEXT({!Loop_Opps.BOD_Status__c})</expression>
    </formulas>
    <interviewLabel>SPX Project totals - Delete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SPX Project totals - Delete</label>
    <loops>
        <name>Loop_Opps</name>
        <label>Loop Opps</label>
        <locationX>576</locationX>
        <locationY>530</locationY>
        <collectionReference>Get_Project_Opportunities</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Amount</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Set_Counts</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Project_Opportunities</name>
        <label>Get Project Opportunities</label>
        <locationX>176</locationX>
        <locationY>590</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Opps</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Project__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Project__c</elementReference></value>
        </filters>
        <filters>
            <field>StageName</field>
            <operator>NotEqualTo</operator>
            <value><stringValue>Closed Lost</stringValue></value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Project</name>
        <label>Update Project</label>
        <locationX>376</locationX>
        <locationY>650</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Project__c</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Total_SPX_Potential__c</field>
            <value><elementReference>varTotal</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Brands_Engaged__c</field>
            <value><elementReference>varBrandsCount</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>BOD_Secured__c</field>
            <value><elementReference>fBODText</elementReference></value>
        </inputAssignments>
        <object>Project__c</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Project_Opportunities</targetReference>
        </connector>
        <filterFormula>AND(NOT({!$Permission.SPX_Bypass_Automation}), NOT(ISBLANK({!$Record.Project__c})))</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varTotal</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varBrands</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varSecuredBrands</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varBrandsCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varBODCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0</numberValue>
        </value>
    </variables>
</Flow>
