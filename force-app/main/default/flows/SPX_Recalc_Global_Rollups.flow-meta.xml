                <operator>EqualTo</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Add_Project</targetReference></connector>
            <label>Project not counted yet</label>
        </rules>
    </decisions>
    <description>Recalculates the roll-up fields on a global parent account from every Brand Relationship and Project Relationship whose Global Parent points at it: open pipeline, distinct brands and distinct strategic projects where an account in the hierarchy is General Contractor. Called by the Brand and Project Relationship flows.</description>
    <formulas>
        <name>fBrandSeen</name>
        <dataType>Boolean</dataType>
        <expression>IF(ISBLANK({!varBrandsText}), false, CONTAINS({!varBrandsText}, TEXT({!Loop_Brand_Relationships.Brand__c}) &amp; &quot;|&quot;))</expression>
    </formulas>
    <formulas>
        <name>fBrandTag</name>
        <dataType>String</dataType>
        <expression>TEXT({!Loop_Brand_Relationships.Brand__c}) &amp; &quot;|&quot;</expression>
    </formulas>
    <formulas>
        <name>fPipe</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!Loop_Brand_Relationships.Open_Pipeline__c}), 0, {!Loop_Brand_Relationships.Open_Pipeline__c})</expression>
            <scale>2</scale>
    </formulas>
    <formulas>
        <name>fProjectSeen</name>
        <dataType>Boolean</dataType>
        <expression>IF(ISBLANK({!varProjectsText}), false, CONTAINS({!varProjectsText}, {!Loop_Project_Relationships.Project__c} &amp; &quot;|&quot;))</expression>
    </formulas>
    <formulas>
        <name>fProjectTag</name>
        <dataType>String</dataType>
        <expression>{!Loop_Project_Relationships.Project__c} &amp; &quot;|&quot;</expression>
    </formulas>
    <interviewLabel>SPX Recalc Global Rollups {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SPX Recalc Global Rollups</label>
    <loops>
        <name>Loop_Brand_Relationships</name>
        <label>Loop Brand Relationships</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Brand_Relationships</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector><targetReference>Add_Pipeline</targetReference></nextValueConnector>
        <noMoreValuesConnector><targetReference>Get_Project_Relationships</targetReference></noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Project_Relationships</name>
        <label>Loop Project Relationships</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Project_Relationships</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector><targetReference>Project_Seen_Check</targetReference></nextValueConnector>
        <noMoreValuesConnector><targetReference>Update_Account</targetReference></noMoreValuesConnector>
    </loops>
    <processMetadataValues>
