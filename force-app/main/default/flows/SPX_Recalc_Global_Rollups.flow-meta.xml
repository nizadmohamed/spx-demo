    <decisions>
        <name>Brand_Seen_Check</name>
        <label>Brand Seen Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector><targetReference>Loop_Brand_Relationships</targetReference></defaultConnector>
        <defaultConnectorLabel>Already counted</defaultConnectorLabel>
        <rules>
            <name>Brand_Is_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fBrandSeen</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Add_Brand</targetReference></connector>
            <label>Brand not counted yet</label>
        </rules>
    </decisions>
    <decisions>
        <name>Project_Seen_Check</name>
        <label>Project Seen Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector><targetReference>Loop_Project_Relationships</targetReference></defaultConnector>
        <defaultConnectorLabel>Already counted</defaultConnectorLabel>
        <rules>
            <name>Project_Is_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
