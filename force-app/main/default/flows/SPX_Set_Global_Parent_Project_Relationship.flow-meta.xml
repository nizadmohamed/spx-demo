<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Set_Global_Parent</name>
        <label>Set Global Parent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>vPositive</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Get_Account.Positive_Brand_Relationships__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>vNeutral</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Get_Account.Neutral_Brand_Relationships__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>vNegative</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Get_Account.Negative_Brand_Relationships__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Global_Parent__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>fGP</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Positive_Brand_Rel_Text__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>fPositive</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Neutral_Brand_Rel_Text__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>fNeutral</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Negative_Brand_Rel_Text__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>fNegative</elementReference></value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Has_Account</name>
        <label>Has Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No account</defaultConnectorLabel>
        <rules>
            <name>Account_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Set_Global_Parent</targetReference></connector>
            <label>Account found</label>
        </rules>
    </decisions>
    <description>Sets Global Parent from the record account: the account Global Ultimate, or the account itself when it is top level. Before save, no extra DML.</description>
    <formulas>
        <name>fGP</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Account.Global_Ultimate__c}), {!Get_Account.Id}, {!Get_Account.Global_Ultimate__c})</expression>
    </formulas>
    <formulas>
        <name>fPositive</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!vPositive}), "", SUBSTITUTE({!vPositive}, ";", ", "))</expression>
    </formulas>
    <formulas>
        <name>fNeutral</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!vNeutral}), "", SUBSTITUTE({!vNeutral}, ";", ", "))</expression>
    </formulas>
    <formulas>
        <name>fNegative</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!vNegative}), "", SUBSTITUTE({!vNegative}, ";", ", "))</expression>
    </formulas>
    <interviewLabel>SPX Set Global Parent - Project Relationship {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SPX Set Global Parent - Project Relationship</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Account</name>
        <label>Get Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Has_Account</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Account__c</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Get_Account</targetReference></connector>
        <filterFormula>AND(NOT({!$Permission.SPX_Bypass_Automation}), NOT(ISBLANK({!$Record.Account__c})))</filterFormula>
        <object>Project_Relationship__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <variables>
        <name>vPositive</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>vNeutral</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>vNegative</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <status>Active</status>
</Flow>
