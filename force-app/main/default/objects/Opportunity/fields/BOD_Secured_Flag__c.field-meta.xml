<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BOD_Secured_Flag__c</fullName>
    <description>Reporting flag: 1 when BOD status is Secured. Average gives the BOD rate. Used by the HVAC segment dashboard.</description>
    <formula>IF(ISPICKVAL(BOD_Status__c, &quot;Secured&quot;), 1, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>BOD Secured Flag</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Percent</type>
</CustomField>
