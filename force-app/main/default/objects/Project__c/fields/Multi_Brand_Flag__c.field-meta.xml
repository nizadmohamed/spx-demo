<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Multi_Brand_Flag__c</fullName>
    <description>Reporting flag: 1 when two or more SPX brands are engaged. Average over strategic projects gives the attachment rate.</description>
    <formula>IF(Brands_Engaged__c &gt;= 2, 1, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Multi-Brand Flag</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
